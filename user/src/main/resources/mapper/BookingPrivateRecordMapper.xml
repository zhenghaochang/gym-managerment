<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="zhenghc.mapper.BookingPrivateRecordMapper">

    <insert id="insert">
        insert into gym.booking_private_record (user_id, member_course_id, coach_id, booking_time, remark)
        value
        (#{userId},#{memberCourseId},#{coachId},#{bookingTime},#{remark})
    </insert>
    <select id="selectAllByUserId" resultType="zhenghc.entity.BookingPrivateRecord">
        select * from gym.booking_private_record where user_id = #{userId}
    </select>
</mapper>